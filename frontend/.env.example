# ---------------------------------------------------------------------------
# Frontend runtime configuration (Vite — values are inlined at build time).
# Copy to `frontend/.env.local` for local development.
# Never put secrets here: everything in this file is public in the bundle.
# ---------------------------------------------------------------------------

# Base URL used for API calls. Keep relative so the browser stays on the same
# origin (Vite proxies to Django in dev, nginx in production).
VITE_API_BASE_URL=/api/v1

# Label shown in the UI chrome ("development", "staging", "production").
VITE_APP_ENV=development

# Product name shown in the sidebar/header.
VITE_APP_NAME=WIMS

# Polling interval for the API health indicator (milliseconds).
VITE_HEALTH_POLL_MS=30000

# Request timeout for API calls (milliseconds).
VITE_REQUEST_TIMEOUT_MS=20000

# --- Development server only -------------------------------------------------
# Port the Vite dev server binds to (0.0.0.0).
VITE_PORT=5173
# Backend origin that /api, /admin and /static are proxied to.
VITE_DEV_API_TARGET=http://127.0.0.1:8000
