# ===========================================================================
# Warehouse & Inventory Management System — environment template
# ===========================================================================
# Copy to `.env` and fill in real values. `.env` is gitignored and is the ONLY
# place secrets live — nothing sensitive is ever committed or baked into an
# image.
#
#   cp .env.example .env
#
# Generate strong values:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"   # secret key
#   openssl rand -base64 32                                        # passwords
# ===========================================================================

# ---------------------------------------------------------------------------
# Django / API
# ---------------------------------------------------------------------------
DJANGO_ENV=production
DJANGO_SETTINGS_MODULE=config.settings.production

# REQUIRED. Must be at least 50 random characters and unique per environment.
DJANGO_SECRET_KEY=replace-me-with-a-64-character-random-string

# MUST stay false in production (the production settings module refuses to
# start if it is true).
DJANGO_DEBUG=false

# Cookie transport. Leave at the defaults for a same-origin deployment: the
# session cookie is HttpOnly and SameSite=Lax, the CSRF cookie is deliberately
# script-readable (the SPA echoes it in X-CSRFToken). Only change these for an
# embedded client served from another registrable domain, where Lax cookies are
# not sent on API calls — and remember SameSite=None requires Secure.
# DJANGO_COOKIE_SAMESITE=Lax
# DJANGO_COOKIE_SECURE=false

# Opt-in Authorization: Bearer session tokens for clients whose cookies the
# browser refuses to store (cross-site embeds). Cookie authentication stays
# primary; keep this off for same-origin deployments. See docs/rbac.md.
AUTH_ENABLE_TOKEN_FALLBACK=false

# Comma-separated hostnames the API will answer for (no wildcards).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,wims.example.com

# Origins allowed to send credentialed cross-origin requests (exact match).
CORS_ALLOWED_ORIGINS=https://wims.example.com

# Origins trusted for unsafe (POST/PUT/PATCH/DELETE) browser requests.
DJANGO_CSRF_TRUSTED_ORIGINS=https://wims.example.com

# Redirect HTTP → HTTPS at Django level (leave false when the proxy does it).
SECURE_SSL_REDIRECT=false
# HSTS max-age in seconds (1 year). Only enable once HTTPS works everywhere.
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_PRELOAD=false

# Expose /api/v1/docs/ (Swagger UI) and /api/v1/redoc/. Off by default in prod.
ENABLE_API_DOCS=false

# Logging: INFO in production, DEBUG while developing.
LOG_LEVEL=INFO
# Optional file logging directory (containers should log to stdout instead).
# LOG_DIR=/app/logs

# ---------------------------------------------------------------------------
# PostgreSQL — internal network only, never published to the host
# ---------------------------------------------------------------------------
POSTGRES_DB=wims
POSTGRES_USER=wims
# REQUIRED. Use a long random password.
POSTGRES_PASSWORD=replace-me-with-a-strong-database-password
# Inside docker-compose the host is the service name.
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Persistent connections (seconds); set 0 to disable.
POSTGRES_CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# Redis — cache + Celery broker; internal network only, password protected
# ---------------------------------------------------------------------------
# REQUIRED. Used by the Redis server (`requirepass`) and by every client URL.
REDIS_PASSWORD=replace-me-with-a-strong-redis-password
# Client URLs are assembled by docker-compose from REDIS_PASSWORD. Override
# them for non-compose deployments (e.g. managed Redis with TLS):
#   REDIS_URL=redis://:password@redis.internal:6379/0
#   CELERY_BROKER_URL=redis://:password@redis.internal:6379/1
#   CELERY_RESULT_BACKEND=redis://:password@redis.internal:6379/2
REDIS_MAXMEMORY=512mb

# Celery worker tuning
CELERY_CONCURRENCY=2
GUNICORN_WORKERS=3

# ---------------------------------------------------------------------------
# Frontend (public values only — they end up in the browser bundle)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
VITE_APP_ENV=production
VITE_APP_NAME=WIMS
VITE_HEALTH_POLL_MS=30000
VITE_REQUEST_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# Edge proxy (nginx) published ports
# ---------------------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443

# ---------------------------------------------------------------------------
# Local development overrides (used by docker-compose.dev.yml)
# ---------------------------------------------------------------------------
DJANGO_DEV_SECRET_KEY=dev-only-insecure-secret-key
DJANGO_DEV_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,[::1],.localhost,api
DJANGO_DEV_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_DEV_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEV_API_PORT=8000
DEV_WEB_PORT=5173
